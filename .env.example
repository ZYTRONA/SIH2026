# ==============================================================================
# POLARIS AI - Environment Template (.env.example)
# Copy this file to .env and replace placeholders with your actual Supabase keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Supabase Project URL found in Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# FastAPI Backend Endpoint
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI / Python)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct PostgreSQL / PostGIS Connection String (Database Settings -> Connection String)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Server runtime
ENVIRONMENT=development
PORT=8000
